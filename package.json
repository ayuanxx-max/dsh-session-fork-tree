{
  "name": "dsh-session-fork-tree",
  "version": "0.7.8",
  "private": false,
  "type": "module",
  "description": "DSH sidebar fork tree: forked sessions sit under their parent with rounded rails, collapse behind a green '+', and highlight the ancestor chain on hover.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "fork",
    "tree",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "style.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ayuanxx-max/dsh-session-fork-tree.git"
  },
  "homepage": "https://github.com/ayuanxx-max/dsh-session-fork-tree#readme",
  "bugs": {
    "url": "https://github.com/ayuanxx-max/dsh-session-fork-tree/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
